{
  "comments": {
    "lineComment": "\\",
    "blockComment": ["( ", " )"]
  },
  "brackets": [
    ["(", ")"],
    ["{:", ":}"]
  ],
  "autoClosingPairs": [
    { "open": "( ", "close": " )" },
    { "open": "{: ", "close": " :}" },
    { "open": "\"", "close": "\"" }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["\"", "\""]
  ],
  "wordPattern": "[^\\s]+",
  "indentationRules": {
    "increaseIndentPattern": "(?<![^\\s])(:|if|else|begin|do|\\?do|while)(?![^\\s])",
    "decreaseIndentPattern": "(?<![^\\s])(;|else|then|until|again|repeat|loop|\\+loop)(?![^\\s])"
  }
}
